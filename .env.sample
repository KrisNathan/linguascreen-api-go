# Secrets: read from /etc/secrets/<KEY> in prod
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/linguascreen?sslmode=disable
OPENAI_API_KEY=
# kid:secret,kid:secret. Tokens verify against any kid listed here.
JWT_KEYS=1:change-me

# Config: read from /etc/config/<KEY> in prod
PROD=0
# kid from JWT_KEYS used to sign new tokens
JWT_SIGNING_KID=1
# OAuth client ID that Google ID tokens must be issued for
GOOGLE_CLIENT_AUD=
# Any OpenAI-compatible endpoint, e.g. OpenRouter
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=

# Dev only! Used by compose.yml to provision the postgres container.
# Keep in sync with POSTGRES_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
