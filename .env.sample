PROD=0

# Database (read by main.go)
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/linguascreen?sslmode=disable

# Cache
REDIS_URL=redis://localhost:6379

# JWT: sign with JWT_SIGNING_KID, verify with any kid in JWT_KEYS (kid:secret,kid:secret)
JWT_SIGNING_KID=1
JWT_KEYS=1:change-me

# External services
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPL_API_KEY=

# Dev only! Used by compose.yml to provision the postgres container.
# Keep in sync with POSTGRES_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres