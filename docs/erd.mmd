---
title: LinguaScreen
---

erDiagram
  User ||--o{ RefreshToken : "signed in with"
  User ||--o{ Course : "learns"
  Course ||--o{ Vocab : "contains"
  Course ||--o{ Sentence : "contains"
  Vocab ||--o{ Occurrence : "seen in"
  Sentence ||--o{ Occurrence : "contains"
  Course ||--o{ PracticeSession : "practiced in"
  PracticeSession ||--o{ Question : "contains"
  Vocab ||--o{ Question : "asked in"
  Occurrence |o--o{ Question : "shown in"
  Vocab ||--o{ FlashCardReview : "reviewed in"

  User {
    uuid id PK
    text google_sub UK "Google ID token sub claim"
    text email
    text name
    timestamptz created_at
  }

  RefreshToken {
    uuid id PK
    uuid user_id FK
    char(64) token_hash UK "SHA-256 hex of the token, the token itself is never stored"
    timestamptz expires_at
    timestamptz revoked_at "null while valid, set on rotation or sign out"
    timestamptz created_at
  }

  %% unique (user_id, learning_language, base_language)
  Course {
    uuid id PK
    uuid user_id FK
    text base_language "native language (ISO 639-1)"
    text learning_language "language to be learned (ISO 639-1)"
    timestamptz created_at
  }

  %% unique (course_id, dict_form, reading)
  %% index (course_id, last_saved_at desc, id desc) for the vocab list
  %% priority = days since last_reviewed_at / (1 + xp), see docs/use_cases/scheduling.md
  Vocab {
    uuid id PK
    uuid course_id FK
    text dict_form "dictionary form, e.g. 読む"
    text reading "of dict_form. JP: hiragana, CN: pinyin with tone marks"
    text translation "first one saved, user-editable, shown in the vocab list"
    int xp "+1 per correct answer, -2 per wrong one, never below 0"
    int correct_streak "correct answers in a row, 0 after a wrong one"
    timestamptz last_reviewed_at "last answer, null until the first one (new)"
    timestamptz last_saved_at "when the latest occurrence was added, orders the vocab list"
    timestamptz created_at
  }

  %% unique (course_id, text_hash)
  Sentence {
    uuid id PK
    uuid course_id FK
    text text "normalized"
    text text_hash "SHA-256 of text, 64 hex chars, computed by the application"
    text translation "whole sentence, in base_language"
    timestamptz created_at
  }

  %% unique (vocab_id, sentence_id, span_start)
  Occurrence {
    uuid id PK
    uuid vocab_id FK
    uuid sentence_id FK
    int span_start "runes (code points) in Sentence.text"
    int span_end "runes (code points), exclusive"
    text surface "as it appears in the sentence, e.g. 読みます"
    text translation "meaning in this sentence, shown in the quiz"
    bool from_part "saved from a part of a compound, never used for fill-in-the-blank"
    timestamptz created_at
  }

  %% unique (course_id) where closed_at is null
  PracticeSession {
    uuid id PK
    uuid course_id FK
    timestamptz created_at
    timestamptz closed_at "completed or expired, null while open"
  }

  Question {
    uuid id PK
    uuid session_id FK
    int position "order in the session"
    text type "fill_blank | translation | reading"
    uuid vocab_id FK
    uuid occurrence_id FK "fill_blank only"
    text_array options "stored as text"
    int correct_index "never sent before answering"
    int answered_index "null until answered"
    bool correct "null until answered"
    timestamptz answered_at "server time, null until answered"
  }

  %% self-graded, updates Vocab.xp like answered questions
  FlashCardReview {
    uuid id PK
    uuid vocab_id FK
    bool correct "the user's self-grade"
    timestamptz reviewed_at "server time"
  }
